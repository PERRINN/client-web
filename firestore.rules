rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isPerrinnAdmin() {
      return request.auth != null && request.auth.token.perrinnAdmin == true;
    }
    match /GreenpowerTelemetry/424/config/view {
      function validChannels(channels) {
        return channels is map && channels.size() <= 512 && channels.values().hasOnly([true]);
      }
      function validOrder(order, channels) {
        return order is list && order.size() == channels.size()
          && order.toSet() == channels.keys().toSet();
      }
      function validView() {
        return request.resource.data.keys().hasAll(['scalars', 'charts', 'revision', 'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['scalars', 'charts', 'scalarOrder', 'chartOrder', 'markers', 'revision', 'updatedBy', 'updatedAt'])
          && (!request.resource.data.keys().hasAny(['markers']) || request.resource.data.markers is map && request.resource.data.markers.size() <= 512)
          && validChannels(request.resource.data.scalars) && validChannels(request.resource.data.charts)
          && (!request.resource.data.keys().hasAny(['scalarOrder']) || validOrder(request.resource.data.scalarOrder, request.resource.data.scalars))
          && (!request.resource.data.keys().hasAny(['chartOrder']) || validOrder(request.resource.data.chartOrder, request.resource.data.charts))
          && request.resource.data.revision is int && request.resource.data.revision > 0
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      }
      allow create: if isPerrinnAdmin() && validView() && request.resource.data.revision == 1;
      allow update: if isPerrinnAdmin() && validView()
        && (!resource.data.keys().hasAny(['markers']) || request.resource.data.keys().hasAny(['markers']))
        && request.resource.data.revision == resource.data.revision + 1;
    }
    match /GreenpowerTelemetry/424/tracks/{trackId} {
      function validGpsPoint(point) {
        return point is map && point.keys().hasAll(['lat', 'lon']) && point.keys().hasOnly(['lat', 'lon'])
          && point.lat is number && point.lat >= -85 && point.lat <= 85
          && point.lon is number && point.lon >= -180 && point.lon <= 180;
      }
      function inside(point, bounds) {
        return point.lat >= bounds.south && point.lat <= bounds.north && point.lon >= bounds.west && point.lon <= bounds.east;
      }
      function validFinish(line, bounds) {
        return line == null || (line is map && line.keys().hasAll(['a', 'b', 'direction'])
          && line.keys().hasOnly(['a', 'b', 'direction'])
          && validGpsPoint(line.a) && validGpsPoint(line.b) && line.a != line.b
          && inside(line.a, bounds) && inside(line.b, bounds)
          && line.direction is int && line.direction in [-1, 1]);
      }
      function validBounds(bounds) {
        return bounds is map && bounds.keys().hasAll(['south', 'north', 'west', 'east'])
          && bounds.keys().hasOnly(['south', 'north', 'west', 'east'])
          && bounds.south is number && bounds.north is number && bounds.west is number && bounds.east is number
          && bounds.south >= -85 && bounds.north <= 85 && bounds.south < bounds.north
          && bounds.west >= -180 && bounds.east <= 180 && bounds.west < bounds.east;
      }
      function validTrack() {
        return request.resource.data.keys().hasAll(['name', 'line', 'bounds', 'cells', 'revision', 'updatedBy', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['name', 'line', 'bounds', 'cells', 'revision', 'updatedBy', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
          && ((request.resource.data.bounds == null && request.resource.data.line == null
              && request.resource.data.cells is list && request.resource.data.cells.size() == 0)
            || (validBounds(request.resource.data.bounds) && validFinish(request.resource.data.line, request.resource.data.bounds)
              && request.resource.data.cells is list && request.resource.data.cells.size() > 0 && request.resource.data.cells.size() <= 64))
          && request.resource.data.cells.toSet().size() == request.resource.data.cells.size()
          && request.resource.data.revision is int && request.resource.data.revision > 0
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      }
      allow create: if isPerrinnAdmin() && validTrack() && request.resource.data.revision == 1;
      allow update: if isPerrinnAdmin() && validTrack() && request.resource.data.revision == resource.data.revision + 1;
    }
    match /GreenpowerTelemetry/424/days/{day}/config/track {
      function validDatasetTrack(data) {
        return day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.keys().hasAll(['trackId', 'revision', 'updatedBy', 'updatedAt'])
          && data.keys().hasOnly(['trackId', 'revision', 'updatedBy', 'updatedAt'])
          && (data.trackId == null || (data.trackId is string && data.trackId.size() > 0 && data.trackId.size() <= 128
            && data.trackId.matches('^[^/]+$') && exists(/databases/$(database)/documents/GreenpowerTelemetry/424/tracks/$(data.trackId))))
          && data.revision is int && data.revision > 0
          && data.updatedBy == request.auth.uid && data.updatedAt == request.time;
      }
      allow create: if isPerrinnAdmin() && validDatasetTrack(request.resource.data) && request.resource.data.revision == 1;
      allow update: if isPerrinnAdmin() && validDatasetTrack(request.resource.data) && request.resource.data.revision == resource.data.revision + 1;
    }
    match /{collection}/{document=**} {
      allow read: if !(collection in ['GreenpowerTelemetry', 'VoiceInputEvents', 'VoiceInputLimits', 'VoiceConversations']);
    }
    match /VoiceConversations/pilot/messages/{messageId} {
      function isVoiceParticipant() {
        return request.auth != null && (request.auth.uid == 'sPJhQ9lcLRgdKcIitszQp4oi7M23'
          || (request.auth.uid == 'QYm5NATKa6MGD87UpNZCTl6IolX2' && isPerrinnAdmin()));
      }
      allow get: if isVoiceParticipant();
      allow list: if isVoiceParticipant() && request.query.limit != null && request.query.limit <= 50;
      // Only the trusted inbox worker publishes completed transcripts.
    }
    match /VoiceInputEvents/{eventId} {
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /GreenpowerTelemetry/{document=**} {
      allow read: if request.auth != null;
    }
    // Collection-group queries must constrain both fields; writes remain server-only.
    match /{parent=**}/sessions/{sessionId} {
      allow list: if request.auth != null
        && resource.data.telemetryRoot == 'GreenpowerTelemetry/424'
        && resource.data.schemaVersion == 2;
    }
    match /userPresence/{userId} {
      // Activity is public. Only the owner can write a server-time-only record.
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly(['lastActiveAt'])
                            && request.resource.data.lastActiveAt == request.time;
    }
    match /lastSeen/{userId} {
      allow read, write: if request.auth.uid == userId;
      match /chats/{chatId} {
        allow read, write: if request.auth.uid == userId;
      }
      match /payments/{payment} {
      	allow create,read: if team == request.auth.uid;
      }
    }
    match /PERRINNMessages/{message} {
      function validFundCommand() {
        let data = request.resource.data;
        return !('fund' in data) || (data.fund is map
          && (!('cancelled' in data.fund) || (data.fund.cancelled is bool
            && (!data.fund.cancelled || isPerrinnAdmin())))
          && (!('closesAt' in data.fund) || (data.fund.closesAt is int && data.fund.closesAt > 0
            && data.fund.closesAt <= 8640000000000000
            && (data.fund.closesAt > request.time.toMillis() || isPerrinnAdmin())))
          && (!('amountGBPTarget' in data.fund) || (data.fund.amountGBPTarget is number
            && (data.fund.amountGBPTarget == 0 || data.fund.amountGBPTarget >= 0.01 || isPerrinnAdmin())))
          && (!('daysLeft' in data.fund) || (data.fund.daysLeft is number
            && (data.fund.daysLeft == 0 || data.fund.daysLeft >= 1 || isPerrinnAdmin()))));
      }
      function validRaisedAmount() {
        let data = request.resource.data;
        return !('fund' in data) || !(data.fund is map) || !('amountGBPRaised' in data.fund)
          || (isPerrinnAdmin() && data.fund.amountGBPRaised is number
            && data.fund.amountGBPRaised >= 0 && data.fund.amountGBPRaised <= 90071992547409);
      }
      allow create: if request.resource.data.user==request.auth.uid
                    && !('emails' in request.resource.data)
                    && request.resource.data.serverTimestamp==request.time
                    && request.resource.data.text.size()<=500
                    && validFundCommand() && validRaisedAmount();
    }
  }
}
